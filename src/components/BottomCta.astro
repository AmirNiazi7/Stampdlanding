---
import bottomCtaBg from '@assets/bottom-cta-bg.png';
---

<section class="bottom-cta-section" id="get-started">
  <div class="container">
    <div class="bottom-cta-card" style={`background-image: url('${bottomCtaBg.src}');`}>
      <div class="cta-grid">
        <!-- Left Column: Copy & App Badges -->
        <div class="cta-copy">
          <h2 class="cta-title">
            Your next favorite is out there.
          </h2>
          <p class="cta-subtitle">
            Keep the places that catch your eye. Make them part of your story.
          </p>

          <!-- Store Badges -->
          <div class="app-badges-row">
            <a href="#android" class="app-badge" aria-label="Coming Soon on Google Play">
              <svg width="22" height="24" viewBox="0 0 22 24" fill="none" class="badge-icon">
                <path d="M0.85 0.5C0.55 0.82 0.38 1.34 0.38 2.02V21.98C0.38 22.66 0.55 23.18 0.85 23.5L0.92 23.57L12.35 12.14V11.86L0.92 0.43L0.85 0.5Z" fill="url(#gp_b)"/>
                <path d="M16.16 15.95L12.35 12.14V11.86L16.16 8.05L16.24 8.1L20.76 10.67C22.05 11.4 22.05 12.6 20.76 13.33L16.24 15.9L16.16 15.95Z" fill="url(#gp_y)"/>
                <path d="M16.24 15.9L12.35 12L0.85 23.5C1.28 23.95 1.98 24.01 2.78 23.56L16.24 15.9Z" fill="url(#gp_r)"/>
                <path d="M16.24 8.1L2.78 0.44C1.98 -0.01 1.28 0.05 0.85 0.5L12.35 12L16.24 8.1Z" fill="url(#gp_g)"/>
                <defs>
                  <linearGradient id="gp_b" x1="11.3" y1="1.72" x2="-2.85" y2="15.87" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#00A0FF"/><stop offset="0.007" stop-color="#00A1FF"/><stop offset="0.26" stop-color="#00BEFF"/><stop offset="0.516" stop-color="#00D2FF"/><stop offset="0.76" stop-color="#00DFFF"/><stop offset="1" stop-color="#00E3FF"/>
                  </linearGradient>
                  <linearGradient id="gp_y" x1="22.5" y1="12" x2="0.32" y2="12" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#FFE000"/><stop offset="0.41" stop-color="#FFBD00"/><stop offset="0.775" stop-color="#FFA500"/><stop offset="1" stop-color="#FF9C00"/>
                  </linearGradient>
                  <linearGradient id="gp_r" x1="14.4" y1="13.84" x2="-6.3" y2="34.5" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#FF3A44"/><stop offset="1" stop-color="#C31162"/>
                  </linearGradient>
                  <linearGradient id="gp_g" x1="-2.12" y1="-5.23" x2="8.8" y2="5.69" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#32A071"/><stop offset="0.069" stop-color="#2DA771"/><stop offset="0.476" stop-color="#15CF74"/><stop offset="0.801" stop-color="#06E775"/><stop offset="1" stop-color="#00F076"/>
                  </linearGradient>
                </defs>
              </svg>
              <div class="badge-text">
                <span class="badge-sub">Coming Soon</span>
                <strong class="badge-store">Google Play</strong>
              </div>
            </a>

            <a href="#ios" class="app-badge" aria-label="Coming Soon on App Store">
              <svg width="22" height="24" viewBox="0 0 24 24" fill="#000000" class="badge-icon">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 1.01-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.07 1.71-1.03 2.73.99.08 2.03-.48 2.65-1.23z"/>
              </svg>
              <div class="badge-text">
                <span class="badge-sub">Coming Soon</span>
                <strong class="badge-store">App Store</strong>
              </div>
            </a>
          </div>
        </div>

        <!-- Right Column: Form -->
        <div class="cta-form-wrapper">
          <form class="waitlist-form" id="waitlist-form">
            <div class="form-inputs-row">
              <div class="form-group">
                <label for="wl-name" class="input-label">Enter Your Name</label>
                <input 
                  type="text" 
                  id="wl-name" 
                  name="name" 
                  placeholder="John Doe" 
                  required 
                />
              </div>

              <div class="form-group">
                <label for="wl-email" class="input-label">Enter Your Email</label>
                <input 
                  type="email" 
                  id="wl-email" 
                  name="email" 
                  placeholder="abc@example.com" 
                  required 
                />
              </div>
            </div>

            <div class="form-group">
              <label for="wl-note" class="input-label">Short Note</label>
              <input 
                type="text" 
                id="wl-note" 
                name="note" 
                placeholder="Message" 
              />
            </div>

            <button type="submit" class="visually-hidden">Submit</button>

            <!-- Success Feedback -->
            <div class="form-success" id="form-success" aria-hidden="true">
              🎉 You're on the list! We'll send your invite shortly.
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');

  if (form && successMsg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successMsg.setAttribute('aria-hidden', 'false');
      successMsg.style.display = 'block';
      form.reset();
    });
  }
</script>

<style>
  .bottom-cta-section {
    padding-block: 4.5rem;
  }

  .bottom-cta-card {
    position: relative;
    background-color: #F48032;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 28px;
    padding: 3.75rem 3.5rem;
    color: #FFFFFF;
    box-shadow: 0 16px 36px rgba(244, 128, 50, 0.22);
    overflow: hidden;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .cta-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 3.5rem;
    }
  }

  /* Left Copy */
  .cta-title {
    font-size: clamp(2rem, 3.8vw, 3.125rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .cta-subtitle {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.55;
    margin-bottom: 2rem;
    max-width: 480px;
  }

  .app-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  .app-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #FFFFFF;
    color: #171714;
    padding: 0.55rem 1.15rem;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .app-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
  }

  .badge-icon {
    flex-shrink: 0;
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .badge-sub {
    font-size: 0.5625rem;
    font-weight: 500;
    color: #64748B;
    letter-spacing: 0.02em;
  }

  .badge-store {
    font-size: 0.875rem;
    font-weight: 700;
    color: #0F172A;
  }

  /* Right Form */
  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .form-inputs-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .form-inputs-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .input-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 0.45rem;
    letter-spacing: -0.01em;
  }

  .form-group input {
    width: 100%;
    padding: 0.85rem 1.35rem;
    background: #FFFFFF;
    border: none;
    border-radius: 9999px;
    font-size: 0.9375rem;
    color: #334155;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: box-shadow var(--transition-fast), outline var(--transition-fast);
  }

  .form-group input::placeholder {
    color: #94A3B8;
  }

  .form-group input:focus {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25);
  }

  .form-success {
    display: none;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 9999px;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #FFFFFF;
    text-align: center;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .bottom-cta-card {
      padding: 2.75rem 1.5rem;
      border-radius: 20px;
    }
  }
</style>
