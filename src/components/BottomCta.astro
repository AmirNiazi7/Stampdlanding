---
import bottomCtaBg from '@assets/bottom-cta-bg.png';
---

<section class="bottom-cta-section" id="get-started">
  <div class="container">
    <div class="bottom-cta-card" style={`background-image: url('${bottomCtaBg.src}');`}>
      <div class="cta-grid">
        <!-- Left Column: Copy & App Badges -->
        <div class="cta-copy">
          <h2 class="cta-title">
            Your next favorite is out there.
          </h2>
          <p class="cta-subtitle">
            Keep the places that catch your eye. Make them part of your story.
          </p>

          <!-- App Store Badges -->
          <div class="app-badges-row">
            <a href="#ios" class="app-badge" aria-label="Download on App Store">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 1.01-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.07 1.71-1.03 2.73.99.08 2.03-.48 2.65-1.23z"/>
              </svg>
              <div class="badge-text">
                <span class="badge-sub">Download on</span>
                <strong class="badge-store">App Store</strong>
              </div>
            </a>

            <a href="#android" class="app-badge" aria-label="Get it on Google Play">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186c-.373-.396-.61-.958-.61-1.614V3.428c0-.656.237-1.218.61-1.614zm11.3 9.072l2.484-2.484-11.45-6.52c-.14.07-.27.158-.387.265l9.353 8.739zm0 2.228l-9.353 8.74c.117.106.247.194.387.264l11.45-6.52-2.484-2.484zm1.114-1.114l2.87 1.635c.813.464.813 1.22 0 1.684l-2.87 1.635-2.228-2.228 2.228-2.226z"/>
              </svg>
              <div class="badge-text">
                <span class="badge-sub">GET IT ON</span>
                <strong class="badge-store">Google Play</strong>
              </div>
            </a>
          </div>
        </div>

        <!-- Right Column: Waitlist Signup Form -->
        <div class="cta-form-wrapper">
          <form class="waitlist-form" id="waitlist-form">
            <div class="form-inputs-row">
              <div class="form-group">
                <label for="wl-name" class="visually-hidden">Enter Your Name</label>
                <input 
                  type="text" 
                  id="wl-name" 
                  name="name" 
                  placeholder="Enter Your Name" 
                  required 
                />
              </div>

              <div class="form-group">
                <label for="wl-email" class="visually-hidden">Enter Your Email</label>
                <input 
                  type="email" 
                  id="wl-email" 
                  name="email" 
                  placeholder="Enter Your Email" 
                  required 
                />
              </div>
            </div>

            <div class="form-group">
              <label for="wl-note" class="visually-hidden">Short Note</label>
              <input 
                type="text" 
                id="wl-note" 
                name="note" 
                placeholder="Short Note or City (e.g. NYC, London)" 
              />
            </div>

            <button type="submit" class="btn btn-white btn-waitlist" id="wl-submit">
              Get Early Access
            </button>

            <!-- Success Feedback -->
            <div class="form-success" id="form-success" aria-hidden="true">
              🎉 You're on the list! We'll send your invite shortly.
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const submitBtn = document.getElementById('wl-submit');

  if (form && successMsg && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.textContent = 'Submitting...';
      
      setTimeout(() => {
        submitBtn.style.display = 'none';
        successMsg.setAttribute('aria-hidden', 'false');
        successMsg.style.display = 'block';
      }, 500);
    });
  }
</script>

<style>
  .bottom-cta-section {
    padding-block: 4.5rem;
  }

  .bottom-cta-card {
    position: relative;
    background-color: var(--color-primary);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: var(--radius-xl);
    padding: 4.5rem 3.5rem;
    color: #FFFFFF;
    box-shadow: var(--shadow-orange);
    overflow: hidden;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 920px) {
    .cta-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 4rem;
    }
  }

  /* Left Copy */
  .cta-title {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
  }

  .cta-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin-bottom: 2.25rem;
    max-width: 480px;
  }

  .app-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .app-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #000000;
    color: #FFFFFF;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    transition: transform var(--transition-fast);
  }

  .app-badge:hover {
    transform: translateY(-2px);
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .badge-sub {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .badge-store {
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.1;
  }

  /* Right Form */
  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-inputs-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .form-inputs-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group input {
    width: 100%;
    padding: 1rem 1.25rem;
    background: #FFFFFF;
    border: none;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .form-group input::placeholder {
    color: #8C8B85;
  }

  .form-group input:focus {
    outline: 2px solid #FFFFFF;
  }

  .btn-waitlist {
    padding: 1rem;
    font-size: 1rem;
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .form-success {
    display: none;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-md);
    padding: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #FFFFFF;
    text-align: center;
  }

  @media (max-width: 640px) {
    .bottom-cta-card {
      padding: 3rem 1.5rem;
      border-radius: var(--radius-lg);
    }
  }
</style>
