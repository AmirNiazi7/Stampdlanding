---
const testimonials = [
  {
    rating: 5,
    quote: "My saved cafés and dinner spots finally have a home. When I'm out, I can open my map and find somewhere I actually want to go.",
    author: "Sarah Jenkins",
    role: "Coffee & brunch explorer",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=120&auto=format&fit=crop&q=80"
  },
  {
    rating: 5,
    quote: "I keep a list for every mood, from Friday-night dinners to weekend brunch. Sharing it with friends makes choosing our next spot so much easier.",
    author: "Marcus Vance",
    role: "Food lover & list maker",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=120&auto=format&fit=crop&q=80"
  },
  {
    rating: 5,
    quote: "That restaurant I spotted on Reels never gets lost in my screenshots now. I save it, go, then leave a note after.",
    author: "Emily Zhao",
    role: "Weekend city explorer",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=120&auto=format&fit=crop&q=80"
  },
  {
    rating: 5,
    quote: "Saving places from TikTok used to mean lost screenshots in camera rolls. Stampd extracts and maps everything instantly.",
    author: "David Lin",
    role: "NYC food & bar curator",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=120&auto=format&fit=crop&q=80"
  },
  {
    rating: 5,
    quote: "The shared maps are a game changer for group trips. Everyone adds their favorites and we pick the nearest gem in seconds.",
    author: "Chloe Bennett",
    role: "Travel & cocktail enthusiast",
    avatar: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=120&auto=format&fit=crop&q=80"
  }
];
---

<section class="testimonials-section" id="testimonials">
  <div class="test-header">
    <div class="pill-badge pill-badge--orange-outline test-badge">
      <span>SAMPLE TESTIMONIALS</span>
    </div>
    <h2 class="test-title">
      Good places. Better stories.
    </h2>
  </div>

  <!-- Auto-scrolling infinite marquee track -->
  <div class="marquee-container" aria-label="Customer Testimonials Carousel">
    <div class="marquee-track">
      <!-- Set 1 -->
      {testimonials.map((t) => (
        <div class="testimonial-card">
          <div class="star-row" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F05314" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="star-svg" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            ))}
          </div>

          <p class="testimonial-quote">
            "{t.quote}"
          </p>

          <div class="card-divider"></div>

          <div class="author-row">
            <img 
              src={t.avatar} 
              alt={t.author} 
              class="author-avatar-img"
              width="44"
              height="44"
              loading="lazy"
            />
            <div class="author-info">
              <strong class="author-name">{t.author}</strong>
              <span class="author-role">{t.role}</span>
            </div>
          </div>
        </div>
      ))}

      <!-- Set 2 (seamless duplication for infinite loop) -->
      {testimonials.map((t) => (
        <div class="testimonial-card" aria-hidden="true">
          <div class="star-row">
            {Array.from({ length: 5 }).map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F05314" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="star-svg" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            ))}
          </div>

          <p class="testimonial-quote">
            "{t.quote}"
          </p>

          <div class="card-divider"></div>

          <div class="author-row">
            <img 
              src={t.avatar} 
              alt={t.author} 
              class="author-avatar-img"
              width="44"
              height="44"
              loading="lazy"
            />
            <div class="author-info">
              <strong class="author-name">{t.author}</strong>
              <span class="author-role">{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding-block: 5.5rem;
    overflow-x: hidden;
    background-color: #FFFFFF;
  }

  .test-header {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: 3.5rem;
    padding-inline: 1.5rem;
  }

  .test-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid #FDCFBA;
    background-color: #FFF6F1;
    color: #F05314;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .test-title {
    font-size: clamp(2.25rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #171714;
    margin: 0;
  }

  /* Infinite auto-scrolling track */
  .marquee-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding-block: 0.5rem;
    mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: marqueeScroll 35s linear infinite;
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Testimonial Card */
  .testimonial-card {
    width: 380px;
    flex-shrink: 0;
    background: #FFFFFF;
    border: 1px solid #ECE7DE;
    border-radius: 24px;
    padding: 2rem 1.75rem 1.6rem;
    box-shadow: 0 4px 20px -6px rgba(28, 25, 23, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px -8px rgba(28, 25, 23, 0.08);
  }

  .star-row {
    display: flex;
    gap: 6px;
    margin-bottom: 1.25rem;
  }

  .star-svg {
    width: 18px;
    height: 18px;
    color: #F05314;
  }

  .testimonial-quote {
    font-size: 0.9375rem;
    color: #3D3935;
    line-height: 1.6;
    margin: 0;
    min-height: 72px;
  }

  .card-divider {
    border-top: 1px solid #EFECE6;
    margin: 1.5rem 0 1.25rem;
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .author-avatar-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background-color: #F2EFE9;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #171714;
  }

  .author-role {
    font-size: 0.75rem;
    color: #8A857E;
  }

  @media (max-width: 640px) {
    .testimonials-section {
      padding-block: 4rem;
    }

    .testimonial-card {
      width: 300px;
      padding: 1.5rem 1.25rem 1.25rem;
      border-radius: 18px;
    }

    .testimonial-quote {
      font-size: 0.875rem;
      min-height: auto;
    }
  }
</style>
