---
const faqs = [
  {
    id: 'faq-1',
    question: 'How does Stampd work?',
    answer: 'Save restaurants, cafés, bars and hidden gems to your personal map. Organize them into lists, find saved spots nearby and get directions. After a visit, mark the place as Stamped and add a note for next time.',
    defaultOpen: true
  },
  {
    id: 'faq-2',
    question: 'Can I save a place from a post link?',
    answer: 'Yes! Just paste any Instagram Reel, TikTok video, or post URL that includes a location tag. Stampd automatically extracts the venue name, coordinates, and details via Google Maps.',
    defaultOpen: false
  },
  {
    id: 'faq-3',
    question: 'Are my lists private or shareable?',
    answer: 'By default, all your lists are private to you. You can choose to make any list public or generate a private invite link to collaborate with friends, partners, or travel buddies.',
    defaultOpen: false
  },
  {
    id: 'faq-4',
    question: 'What does marking a place as Stamped do?',
    answer: "Marking a place as Stamped records your visit in your passport history, logs the date, lets you add personal notes and photos, and moves it to your 'Visited' archive.",
    defaultOpen: false
  }
];
---

<section class="faq-section" id="faq">
  <div class="container">
    <div class="faq-grid">
      <!-- Left: Actual Interactive Map of United States with Pin Locations -->
      <div class="map-card-wrapper">
        <div class="us-map-card">
          <!-- Top City Selector Filter Chips -->
          <div class="us-map-chips-bar" aria-label="Select US Location">
            <button type="button" class="map-chip active" data-city="us">🇺🇸 All US</button>
            <button type="button" class="map-chip" data-city="nyc">New York</button>
            <button type="button" class="map-chip" data-city="la">Los Angeles</button>
            <button type="button" class="map-chip" data-city="chicago">Chicago</button>
            <button type="button" class="map-chip" data-city="austin">Austin</button>
            <button type="button" class="map-chip" data-city="miami">Miami</button>
          </div>

          <!-- Leaflet Interactive Map Viewport -->
          <div id="us-leaflet-map" class="us-map-viewport" role="region" aria-label="Interactive map of the United States with saved pin locations"></div>

          <!-- Floating Info Overlay Card at bottom -->
          <div class="us-map-info-card" id="map-info-card">
            <div class="info-badge">
              <span class="info-dot"></span>
              <span id="map-info-badge">565 Saved Places</span>
            </div>
            <h3 class="info-title" id="map-info-title">United States</h3>
            <p class="info-desc" id="map-info-desc">Explore your curated restaurants, cafes & hidden gems across America.</p>
          </div>
        </div>
      </div>

      <!-- Right: FAQ Accordions -->
      <div class="faq-accordion-wrapper">
        <h2 class="faq-main-title">
          A few good questions.
        </h2>

        <div class="accordion-list">
          {faqs.map((faq) => (
            <div class:list={['accordion-item', { 'is-open': faq.defaultOpen }]} id={faq.id}>
              <button 
                type="button" 
                class="accordion-trigger" 
                aria-expanded={faq.defaultOpen ? 'true' : 'false'}
                aria-controls={`content-${faq.id}`}
              >
                <span class="accordion-question">{faq.question}</span>
                <span class="accordion-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19" class="vert-line"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </button>
              <div 
                class="accordion-content" 
                id={`content-${faq.id}`}
                aria-hidden={faq.defaultOpen ? 'false' : 'true'}
              >
                <p class="accordion-answer">{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Accordion Interaction
  const accordionItems = document.querySelectorAll('.accordion-item');

  accordionItems.forEach((item) => {
    const trigger = item.querySelector('.accordion-trigger');
    const content = item.querySelector('.accordion-content');

    if (trigger && content) {
      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          content.setAttribute('aria-hidden', 'true');
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          content.setAttribute('aria-hidden', 'false');
        }
      });
    }
  });

  // Actual United States Map Initialization via Leaflet
  const initUsMap = () => {
    const mapEl = document.getElementById('us-leaflet-map');
    if (!mapEl || !(window as any).L) return;

    const L = (window as any).L;

    // US Pin Locations with real coordinates & details
    const usLocations: Record<string, { name: string; state: string; coords: [number, number]; count: string; desc: string; zoom: number }> = {
      us: {
        name: 'United States',
        state: 'USA',
        coords: [39.0, -96.0],
        count: '565 Saved Places',
        desc: 'Explore your curated restaurants, cafes & hidden gems across America.',
        zoom: 4
      },
      nyc: {
        name: 'New York, NY',
        state: 'New York',
        coords: [40.7223, -73.9987], // SoHo / Lower Manhattan
        count: '142 Saved Spots',
        desc: 'SoHo, West Village, Lower East Side & Brooklyn favorites.',
        zoom: 12
      },
      la: {
        name: 'Los Angeles, CA',
        state: 'California',
        coords: [34.0522, -118.2437],
        count: '98 Saved Spots',
        desc: 'Silver Lake, Venice, West Hollywood & Downtown dining.',
        zoom: 11
      },
      chicago: {
        name: 'Chicago, IL',
        state: 'Illinois',
        coords: [41.8819, -87.6475], // West Loop
        count: '76 Saved Spots',
        desc: 'West Loop, Fulton Market, Wicker Park & Logan Square.',
        zoom: 12
      },
      austin: {
        name: 'Austin, TX',
        state: 'Texas',
        coords: [30.2672, -97.7431],
        count: '64 Saved Spots',
        desc: 'South Congress, East Austin & Downtown cocktail bars.',
        zoom: 12
      },
      miami: {
        name: 'Miami, FL',
        state: 'Florida',
        coords: [25.7617, -80.1918],
        count: '53 Saved Spots',
        desc: 'Wynwood, Design District, South Beach & Brickell spots.',
        zoom: 12
      },
      sf: {
        name: 'San Francisco, CA',
        state: 'California',
        coords: [37.7749, -122.4194],
        count: '85 Saved Spots',
        desc: 'Mission District, North Beach & Hayes Valley gems.',
        zoom: 12
      },
      seattle: {
        name: 'Seattle, WA',
        state: 'Washington',
        coords: [47.6062, -122.3321],
        count: '47 Saved Spots',
        desc: 'Capitol Hill, Pike Place & Ballard roasters.',
        zoom: 12
      }
    };

    // Initialize Leaflet Map centered on Continental US
    const map = L.map('us-leaflet-map', {
      center: usLocations.us.coords,
      zoom: usLocations.us.zoom,
      minZoom: 3,
      maxZoom: 16,
      zoomControl: false,
      scrollWheelZoom: false,
      attributionControl: false
    });

    // Add CartoDB Voyager Map Tiles (clean, warm, modern aesthetic)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    // Add subtle top-right Zoom Control
    L.control.zoom({ position: 'topright' }).addTo(map);

    // Custom Stampd Orange Pin Icon
    const createPinIcon = (isActive = false) => {
      const size = isActive ? 34 : 28;
      return L.divIcon({
        className: 'stampd-map-pin',
        html: `
          <div class="pin-marker ${isActive ? 'is-active' : ''}">
            <svg width="${size}" height="${size + 8}" viewBox="0 0 28 36" fill="none">
              <filter id="pin-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="rgba(240, 83, 20, 0.45)"/>
              </filter>
              <path d="M14 0C6.268 0 0 6.268 0 14c0 10.5 14 22 14 22s14-11.5 14-22C28 6.268 21.732 0 14 0z" fill="#F05314" filter="url(#pin-shadow)"/>
              <circle cx="14" cy="14" r="5.5" fill="#FFFFFF"/>
            </svg>
          </div>
        `,
        iconSize: [size, size + 8],
        iconAnchor: [size / 2, size + 8],
        popupAnchor: [0, -(size + 4)]
      });
    };

    // Update floating info overlay card
    const updateInfoCard = (locKey: string) => {
      const loc = usLocations[locKey] || usLocations.us;
      const titleEl = document.getElementById('map-info-title');
      const badgeEl = document.getElementById('map-info-badge');
      const descEl = document.getElementById('map-info-desc');

      if (titleEl) titleEl.textContent = loc.name;
      if (badgeEl) badgeEl.textContent = loc.count;
      if (descEl) descEl.textContent = loc.desc;

      // Update active state on chips
      document.querySelectorAll('.map-chip').forEach((btn) => {
        const cityAttr = btn.getAttribute('data-city');
        btn.classList.toggle('active', cityAttr === locKey);
      });
    };

    // Create markers for US cities
    const markers: Record<string, any> = {};

    Object.entries(usLocations).forEach(([key, loc]) => {
      if (key === 'us') return;

      const marker = L.marker(loc.coords, {
        icon: createPinIcon(false),
        title: loc.name
      }).addTo(map);

      marker.on('click', () => {
        Object.values(markers).forEach((m: any) => m.setIcon(createPinIcon(false)));
        marker.setIcon(createPinIcon(true));
        updateInfoCard(key);
        map.flyTo(loc.coords, loc.zoom, { duration: 1.2 });
      });

      markers[key] = marker;
    });

    // Chip click listeners for quick city navigation
    document.querySelectorAll('.map-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const cityKey = chip.getAttribute('data-city') || 'us';
        const loc = usLocations[cityKey];
        if (!loc) return;

        updateInfoCard(cityKey);

        if (cityKey === 'us') {
          Object.values(markers).forEach((m: any) => m.setIcon(createPinIcon(false)));
          map.flyTo(loc.coords, loc.zoom, { duration: 1.2 });
        } else {
          Object.values(markers).forEach((m: any) => m.setIcon(createPinIcon(false)));
          if (markers[cityKey]) {
            markers[cityKey].setIcon(createPinIcon(true));
          }
          map.flyTo(loc.coords, loc.zoom, { duration: 1.2 });
        }
      });
    });
  };

  // Run when Leaflet is available or on page ready
  if ((window as any).L) {
    initUsMap();
  } else {
    window.addEventListener('load', () => {
      setTimeout(initUsMap, 150);
    });
  }
</script>

<style>
  .faq-section {
    padding-block: 5.5rem;
    background-color: #FFFFFF;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
    max-width: 1200px;
    margin-inline: auto;
  }

  @media (min-width: 940px) {
    .faq-grid {
      grid-template-columns: 460px 1fr;
      gap: 4.5rem;
    }
  }

  /* Left United States Map Card */
  .map-card-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .us-map-card {
    width: 100%;
    max-width: 460px;
    height: 480px;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 16px 38px -8px rgba(28, 25, 23, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04);
    border: 1px solid #ECE7DE;
    background-color: #F8F6F0;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .us-map-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 44px -8px rgba(28, 25, 23, 0.16);
  }

  /* Map Viewport */
  .us-map-viewport {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #EFEFEA;
  }

  /* Top City Selector Chips Bar */
  .us-map-chips-bar {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    z-index: 400;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .us-map-chips-bar::-webkit-scrollbar {
    display: none;
  }

  .map-chip {
    flex-shrink: 0;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(232, 231, 226, 0.9);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    transition: all var(--transition-fast);
  }

  .map-chip:hover {
    background: #FFFFFF;
    color: var(--color-primary);
    border-color: rgba(240, 83, 20, 0.4);
    transform: translateY(-1px);
  }

  .map-chip.active {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
    box-shadow: 0 3px 10px rgba(240, 83, 20, 0.35);
  }

  /* Bottom Floating Info Card Overlay */
  .us-map-info-card {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    z-index: 400;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border-radius: 20px;
    padding: 1rem 1.25rem;
    box-shadow: 0 8px 24px rgba(20, 16, 12, 0.1);
    border: 1px solid rgba(232, 231, 226, 0.85);
    transition: transform var(--transition-fast);
  }

  .info-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .info-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
    animation: pulseSubtle 2s infinite ease-in-out;
  }

  .info-title {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .info-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  /* Right FAQ Accordions */
  .faq-accordion-wrapper {
    width: 100%;
  }

  .faq-main-title {
    font-size: clamp(2rem, 3.8vw, 3.125rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
    margin-bottom: 2.25rem;
  }

  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .accordion-item {
    background-color: #FFFFFF;
    border: 1px solid #ECE7DE;
    border-radius: 20px;
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .accordion-item:hover {
    border-color: #DBD5C7;
    box-shadow: 0 4px 16px rgba(28, 25, 23, 0.04);
  }

  .accordion-item.is-open {
    border-color: #E2DDD0;
    box-shadow: 0 6px 20px rgba(28, 25, 23, 0.05);
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .accordion-question {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .accordion-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #171714;
    color: #FFFFFF;
    flex-shrink: 0;
    transition: transform var(--transition-base), background-color var(--transition-base);
  }

  .vert-line {
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    transform-origin: center;
  }

  .accordion-item.is-open .vert-line {
    opacity: 0;
    transform: scaleY(0);
  }

  .accordion-item.is-open .accordion-icon {
    transform: rotate(90deg);
    background-color: var(--color-primary);
  }

  .accordion-content {
    display: none;
    padding-inline: 1.75rem;
    padding-bottom: 1.5rem;
  }

  .accordion-item.is-open .accordion-content {
    display: block;
  }

  .accordion-answer {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-section {
      padding-block: 3.5rem;
    }

    .us-map-card {
      height: 400px;
    }

    .accordion-trigger {
      padding: 1.25rem 1.25rem;
    }

    .accordion-content {
      padding-inline: 1.25rem;
      padding-bottom: 1.25rem;
    }
  }
</style>
