---
import secondMockup from '@assets/2ndmockup.svg';
---

<section class="browsing-section" id="features">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="pill-badge pill-badge--orange-outline section-badge">
        <span>A Little Like Browsing</span>
      </div>
      <h2 class="section-title">
        Your places. Not just any places.
      </h2>
      <p class="section-subtitle">
        Filter and view places you want on your map. So you can discover and bookmark spots before you even want to forget.
      </p>
    </div>

    <!-- Main Feature Showcase -->
    <div class="browsing-grid">
      <!-- Left Side: 3 Feature Cards -->
      <div class="feature-cards-col">
        <div class="feature-card active-card">
          <div class="card-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F05314" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="card-text">
            <h3 class="card-title">See what's close</h3>
            <p class="card-desc">Your saved places, right where you need them.</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="card-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F05314" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>
          <div class="card-text">
            <h3 class="card-title">Find your kind of spot</h3>
            <p class="card-desc">Narrow your map by distance and category.</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="card-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F05314" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
            </svg>
          </div>
          <div class="card-text">
            <h3 class="card-title">Make a move</h3>
            <p class="card-desc">Open place details, then get directions.</p>
          </div>
        </div>
      </div>

      <!-- Right Side: 3 Fanned Phone Mockups using 2ndmockup.svg -->
      <div class="phones-fan-stage">
        <!-- Background contour wave lines -->
        <div class="fan-bg-waves" aria-hidden="true">
          <svg viewBox="0 0 800 600" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 300C200 150 450 450 750 250" stroke="#E3E6F5" stroke-width="2" />
            <path d="M50 360C200 210 450 510 750 310" stroke="#E3E6F5" stroke-width="2" />
            <path d="M50 420C200 270 450 570 750 370" stroke="#E3E6F5" stroke-width="2" />
            <path d="M50 480C200 330 450 630 750 430" stroke="#E3E6F5" stroke-width="2" />
          </svg>
        </div>

        <div class="mockup-2-wrapper">
          <img 
            src={secondMockup.src} 
            alt="Stampd mobile app interface showing map view, venue details, and saved lists" 
            class="mockup-2-svg" 
            width="856" 
            height="572" 
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .browsing-section {
    padding-block: 4.5rem;
    position: relative;
    overflow: hidden;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: 3.5rem;
  }

  .section-badge {
    margin-inline: auto;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .browsing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media screen and (min-width: 960px) {
    .browsing-grid {
      grid-template-columns: 360px 1fr;
      gap: 3.5rem;
    }
  }

  /* Left 3 Cards */
  .feature-cards-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .feature-card:hover,
  .feature-card.active-card {
    border-color: rgba(240, 83, 20, 0.4);
    box-shadow: var(--shadow-sm);
    transform: translateX(4px);
  }

  .card-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: #FFF4ED;
    border: 1px solid rgba(240, 83, 20, 0.15);
    flex-shrink: 0;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Right Side Mockup Stage */
  .phones-fan-stage {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 380px;
  }

  .fan-bg-waves {
    position: absolute;
    inset: -20px;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .fan-bg-waves svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mockup-2-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 720px;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform var(--transition-base);
  }

  .mockup-2-wrapper:hover {
    transform: translateY(-4px) scale(1.015);
  }

  .mockup-2-svg {
    width: 100%;
    max-width: 720px;
    height: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 20px 36px rgba(22, 18, 14, 0.16));
  }
</style>
