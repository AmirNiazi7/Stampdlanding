---
import logoSvg from '@assets/logo.svg';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <!-- Brand & Social Column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo" aria-label="Stampd Homepage">
          <img 
            src={logoSvg.src} 
            alt="Stampd" 
            class="footer-logo-img" 
            width="151" 
            height="81" 
            loading="lazy" 
            decoding="async" 
          />
        </a>
        <p class="footer-tagline">Your Taste, Mapped.</p>

        <!-- Social Icons -->
        <div class="social-links">
          <a href="#instagram" class="social-btn" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="#twitter" class="social-btn" aria-label="Twitter / X">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
            </svg>
          </a>
          <a href="#tiktok" class="social-btn" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links Columns -->
      <div class="footer-links-group">
        <div class="footer-col">
          <h4 class="col-heading">Your Stamps</h4>
          <ul class="col-list">
            <li><a href="#features">Explore</a></li>
            <li><a href="#features">Lists</a></li>
            <li><a href="#social-import">Import</a></li>
            <li><a href="#wishlist">Wishlist</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-heading">Explore</h4>
          <ul class="col-list">
            <li><a href="#how-it-works">How it works</a></li>
            <li><a href="#invite-friends">Friends</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#blog">Blog</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-heading">Legal</h4>
          <ul class="col-list">
            <li><a href="#privacy">Privacy</a></li>
            <li><a href="#terms">Terms</a></li>
            <li><a href="#security">Security</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Footer Bottom Row -->
    <div class="footer-bottom">
      <p class="copyright">© {new Date().getFullYear()} Stampd. All rights reserved.</p>
      <p class="footer-motto">Saved places. Food and spots. Your map.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #FFFFFF;
    border-top: 1px solid var(--color-border);
    padding-top: 4.5rem;
    padding-bottom: 3rem;
    margin-top: auto;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 860px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-brand-col {
    max-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .footer-logo-img {
    height: 42px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #FAF9F5;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    background: #FFF4ED;
    border-color: rgba(240, 83, 20, 0.3);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .footer-links-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .col-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }

  .col-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .col-list a {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .col-list a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-motto {
    font-weight: 500;
  }
</style>
