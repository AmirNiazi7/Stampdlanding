---
import workflowBg from '@assets/workflow-bg.jpg';

const steps = [
  {
    num: '01',
    title: 'Save the possibility',
    desc: 'Find a place on social or hear about a spot from a friend? Add it to your map.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>`
  },
  {
    num: '02',
    title: 'Make it your maps',
    desc: "Keep it close on your map. Put it in a list for whenever's next.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>`
  },
  {
    num: '03',
    title: 'Go. Enjoy. Stamp.',
    desc: "Visit the spot, check it off from the map, and it's for next time.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>`
  }
];
---

<section class="workflow-section" id="how-it-works">
  <div class="container">
    <div class="workflow-card" style={`background-image: url('${workflowBg.src}');`}>
      <div class="workflow-header">
        <h2 class="workflow-title">
          A good find deserves<br class="desktop-br" /> more than a screenshot.
        </h2>
        <p class="workflow-subtitle">
          One central place for all the places you want to try — and the ones you'll come back to.
        </p>
      </div>

      <div class="workflow-steps-grid">
        {steps.map((step) => (
          <div class="step-column">
            <div class="step-top-row">
              <span class="step-num">{step.num}</span>
              <div class="step-icon" set:html={step.icon} />
            </div>
            <div class="step-divider"></div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-section {
    padding-block: 2.5rem;
  }

  .workflow-card {
    position: relative;
    background-color: #F05314;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: var(--radius-xl);
    padding: 3.75rem 3rem;
    color: #FFFFFF;
    box-shadow: var(--shadow-orange);
    overflow: hidden;
  }

  .workflow-header {
    margin-bottom: 3.5rem;
    max-width: 820px;
  }

  .workflow-title {
    font-size: clamp(2.125rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .desktop-br {
    display: none;
  }

  @media screen and (min-width: 768px) {
    .desktop-br {
      display: inline;
    }
  }

  .workflow-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.5;
  }

  .workflow-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media screen and (min-width: 840px) {
    .workflow-steps-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .step-column {
    display: flex;
    flex-direction: column;
  }

  .step-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .step-num {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.75);
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.9);
  }

  .step-divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.25);
    margin-bottom: 1.25rem;
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
    letter-spacing: -0.015em;
  }

  .step-desc {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }

  @media screen and (max-width: 640px) {
    .workflow-card {
      padding: 2.5rem 1.5rem;
      border-radius: var(--radius-lg);
    }
  }
</style>
