---
import pasteLinkSvg from '@assets/pastelink.svg';
---

<section class="social-import-section" id="social-import">
  <div class="container">
    <div class="import-grid">
      <!-- Left Copy -->
      <div class="import-copy">
        <div class="pill-badge pill-badge--orange-outline import-badge">
          <span>A LITTLE LIKE SEARCHING</span>
        </div>
        <h2 class="import-title">
          Found it in a post?<br />Put it on the map.
        </h2>
        <p class="import-desc">
          Paste a link to a post tagging a venue. Stampd extracts the place and confirms it through Google.
        </p>
      </div>

      <!-- Right Visual Importer Mockup using pastelink.svg -->
      <div class="import-card-wrapper">
        <img 
          src={pasteLinkSvg.src} 
          alt="Stampd Import from Social venue extraction mockup" 
          class="import-mockup-svg" 
          width="788" 
          height="479" 
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .social-import-section {
    padding-block: 5.5rem;
    background-color: #FFFFFF;
  }

  .import-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
    max-width: 1160px;
    margin-inline: auto;
  }

  @media (min-width: 960px) {
    .import-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 4.5rem;
    }
  }

  /* Left Copy */
  .import-copy {
    max-width: 480px;
  }

  .import-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid #FDCFBA;
    background-color: #FFF6F1;
    color: #F05314;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .import-title {
    font-size: clamp(2.25rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #171714;
    margin-bottom: 1.35rem;
  }

  .import-desc {
    font-size: 1.125rem;
    color: #6A6762;
    line-height: 1.6;
  }

  /* Right Importer Mockup */
  .import-card-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .import-mockup-svg {
    width: 100%;
    max-width: 620px;
    height: auto;
    display: block;
    transition: transform var(--transition-base);
  }

  .import-mockup-svg:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .social-import-section {
      padding-block: 4rem;
    }

    .import-mockup-svg {
      max-width: 100%;
    }
  }
</style>
